{
  "name": "sicor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "masefer:smoke": "tsx src/server/masefer/smoke.ts",
    "catalog:bootstrap": "tsx src/server/bootstrap/cli.ts",
    "sync:check": "tsx src/server/jobs/cli.ts",
    "db:migrate:run": "tsx src/server/db/migrate.ts",
    "build:migrate": "esbuild src/server/db/migrate.ts --bundle --platform=node --format=cjs --target=node22 --external:pg-native --outfile=out/migrate.cjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
